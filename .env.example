
NODE_ENV = production
NEXT_PUBLIC_GRAPH_API_URL = https://api.myikas.com/api/v2/admin/graphql
NEXT_PUBLIC_ADMIN_URL = https://{storeName}.myikas.com/admin
NEXT_PUBLIC_DEPLOY_URL = http://localhost:3001

# Subdomain System (IMPORTANT!)
# For local development: localhost
# For production: your-domain.com (without https://)
NEXT_PUBLIC_BASE_DOMAIN = localhost

SECRET_COOKIE_PASSWORD = your_session_cookie_password_here
NEXT_PUBLIC_CLIENT_ID = your_store_app_id_here
CLIENT_SECRET = your_store_app_secret_here

# Database configuration (Required for Prisma)
DATABASE_URL = postgresql://user:password@host:5432/dbname

# Cloudflare R2 Storage (Required for image uploads)
# Get these from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID = your_cloudflare_account_id_here
R2_ACCESS_KEY_ID = your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY = your_r2_secret_access_key_here
R2_BUCKET_NAME = refund-images
R2_PUBLIC_URL = https://pub-xxxxx.r2.dev

