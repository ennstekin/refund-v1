// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuthToken {
  id              String   @id
  merchantId      String
  authorizedAppId String?  @unique
  salesChannelId  String?
  type            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deleted         Boolean  @default(false)

  accessToken     String
  tokenType       String
  expiresIn       Int
  expireDate      DateTime
  refreshToken    String
  scope           String?
}

model RefundRequest {
  id              String   @id @default(cuid())
  orderId         String   @unique
  orderNumber     String
  merchantId      String
  status          String   // pending, processing, completed, rejected
  reason          String?  // damaged_product, wrong_size, changed_mind, defective, not_as_described, other
  reasonNote      String?  // Ek açıklama
  trackingNumber  String?
  images          String?  // JSON array of base64 images or URLs
  source          String   @default("dashboard") // dashboard, portal - indicates where the refund was created
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  notes           RefundNote[]
  timeline        RefundTimeline[]

  @@index([merchantId]) // Performance: Fast lookup by merchant
  @@index([merchantId, status]) // Performance: Filter by merchant and status
  @@index([merchantId, createdAt]) // Performance: Order by date per merchant
}

model RefundNote {
  id              String   @id @default(cuid())
  refundRequestId String
  content         String
  createdBy       String   // user who created the note
  createdAt       DateTime @default(now())

  refundRequest   RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
}

model RefundTimeline {
  id              String   @id @default(cuid())
  refundRequestId String
  eventType       String   // created, status_changed, note_added, tracking_updated, etc.
  eventData       String?  // JSON data for the event
  description     String   // Human readable description
  createdBy       String?  // Who triggered this event
  createdAt       DateTime @default(now())

  refundRequest   RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
}

model Merchant {
  id              String   @id
  authorizedAppId String   @unique
  storeName       String?
  email           String?

  // Subdomain system
  subdomain       String?  @unique // Auto-generated subdomain (e.g., "ornek-magaza")
  subdomainStatus String   @default("pending") // pending, active, suspended
  subdomainChangedAt DateTime? // Last time subdomain was changed
  subdomainChangeCount Int   @default(0) // How many times subdomain was changed (limit to 1)

  // Custom domain (optional)
  portalUrl       String?  // Custom portal URL (e.g., iade.magaza.com)
  customDomainStatus String @default("none") // none, pending, verified, failed

  portalEnabled   Boolean  @default(true)
  onboardingCompleted Boolean @default(false) // Has merchant completed onboarding?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Restricted/Reserved subdomain list (system subdomains that can't be used)
model RestrictedSubdomain {
  id        String   @id @default(cuid())
  subdomain String   @unique
  reason    String   // "system", "reserved", "inappropriate"
  createdAt DateTime @default(now())
}

// Optional: Subdomain reservation tracking (for future use)
model SubdomainReservation {
  id         String    @id @default(cuid())
  subdomain  String    @unique
  merchantId String?   // null if available
  status     String    @default("available") // available, reserved, active
  reservedAt DateTime  @default(now())
  expiresAt  DateTime?

  @@index([subdomain, status])
}
